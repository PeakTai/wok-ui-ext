{
  "name": "wok-ui-ext",
  "version": "0.1.1",
  "description": "wok-ui 的扩展库，提供一套科技蓝风格 + 多主题的组件库，覆盖常用的组件",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.less",
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/lib/*/index.d.ts",
      "import": "./dist/lib/*/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:docs": "vite build docs-site && rm -rf docs/ && mv docs-site/dist docs/",
    "dev:docs": "vite docs-site",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Peak Tai <peaktai@qq.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "fast-glob": "^3.3.3",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "less": "^4.2.1",
    "marked": "^18.0.5",
    "minisearch": "^7.2.0",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5",
    "vite": "^8.1.3",
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "wok-ui": "^1.0.0"
  }
}
